#!/usr/bin/env python3
"""테스트용 가짜 hc. $FAKE_HC_DIR/state.json 을 읽고 바꾸며, 호출 argv 를 calls.jsonl 에 남긴다.
state.json 의 "delay": {명령: 초} 가 있으면 그 명령은 처리 전에 그만큼 잔다.
"<명령> <대상>"(예: "get t100") 키는 그 대상에만 적용되고 명령 키보다 먼저 본다.

0.2.0(herdr-orch 설계 13.7): "on_send": {주소: accept|drop|working|mismatch}, "on_clear": {주소: turn|none|event}(기본 turn:
`/clear` 키를 받으면 turn+1·idle. event: 상태는 그대로 두고, keys 를 받을 때 이미 붙어 있던 events 구독에만 0.3초 뒤
turn+1·idle 의 turn 알림(이름이 있으면 title 알림도)을 준다. keys 는 그 구독이 붙기를 3초까지 기다리고 기록에 subscribed 를
남긴다), "keys": [{terminal, keys}] 기록, "layout": {탭: [주소…]}(connect 의 doc 순서), "doc"(있으면 connect doc.get 결과의
value 그대로). events 는 실제 hc 꼴이다: 처음 스냅숏 한 줄 {"channel", "seq", "terminals": [get 꼴]}, 그 뒤 0.05초마다
상태를 보고 바뀐 것마다 JSON-RPC 알림 한 줄 {"jsonrpc", "method": "event", "params": {"type": status|turn|title, "terminal",
"seq", "data"}}(FAKE_HC_EVENTS_MAX 초 뒤 끝). 구독은 "subscribers": {주소: [pid…]} 에 이름을 올린다.
"noise": {주소: 초} 면 스냅숏 뒤 그 초 동안 heartbeat 알림을 쉬지 않고 낸다(건너뛸 알림이 이어지는 구독 흉내)."""
import fcntl
import json
import os
import sys
import time
from pathlib import Path

DIR = Path(os.environ["FAKE_HC_DIR"])


def out(obj):
    print(json.dumps(obj))


def fail(kind, code, message=""):
    sys.stderr.write(json.dumps({"error": {"kind": kind, "message": message or kind, "hint": ""}}) + "\n")
    return code


def opt(args, name, default=None):
    if name in args:
        return args[args.index(name) + 1]
    return default


def find(st, ref):
    if ref in st["terminals"]:
        return st["terminals"][ref]
    named = [t for t in st["terminals"].values() if t.get("name") == ref]
    live = [t for t in named if t["state"] == "live"]
    return (live or named or [None])[0]


def ls_item(t):
    return {"address": t["address"], "name": t.get("name"), "state": t["state"],
            "status": (t.get("status") or {}).get("state"), "turn": t.get("turn", 0),
            "reason": t.get("reason"), "cwd": t.get("cwd", "/")}


def doc_of(st):
    """core 문서 herdr-app 의 value 흉내(실제 꼴): 라벨 herdr.space·herdr.tab 이 있는 live 터미널을 탭 root row 의 block
    {"type": "block", "id": "p<주소>", "content": {"terminal": <주소>}} 으로(순서는 layout)."""
    spaces = {}
    for t in st["terminals"].values():
        labels = t.get("labels") or {}
        sp, tb = labels.get("herdr.space"), labels.get("herdr.tab")
        if t["state"] == "live" and sp and tb:
            spaces.setdefault(sp, {}).setdefault(tb, []).append(t["address"])
    layout = st.get("layout", {})
    result = []
    for sp, tabs in spaces.items():
        items = []
        for tb, addrs in tabs.items():
            first = [a for a in layout.get(tb, []) if a in addrs]
            order = first + [a for a in addrs if a not in first]
            items.append({"id": tb, "name": tb, "root": {"type": "row", "id": f"r{tb}", "children": [
                {"type": "block", "id": f"p{a}", "content": {"terminal": a}} for a in order]}})
        result.append({"id": sp, "name": sp, "folder": "/", "tabs": items})
    return {"spaces": result}


def notice(kind, address, seq, data):
    """실제 hc events 의 사건 알림 한 줄."""
    return {"jsonrpc": "2.0", "method": "event", "params": {"type": kind, "terminal": address, "seq": seq, "data": data}}


def handle(st, argv, lines=()):
    if not argv:
        return fail("usage", 2)
    cmd, args = argv[0], argv[1:]
    f = st.get("fail", {}).get(cmd)
    if cmd == "run":
        if f and not f.get("create"):
            return fail(f["kind"], f.get("code", 1))
        sep = args.index("--")
        opts, prog = args[:sep], args[sep + 1:]
        labels = {}
        for i, o in enumerate(opts):
            if o == "--label":
                k, v = opts[i + 1].split("=", 1)
                labels[k] = v
        addr = f"t{st['next']}"
        st["next"] += 1
        st["terminals"][addr] = {
            "address": addr, "name": opt(opts, "--name"), "state": "live", "status": None,
            "argv": prog, "labels": labels, "reason": None, "turn": 0, "cwd": opt(opts, "--cwd", "/"),
            "exit_code": None, "flags": [o for o in opts if o in ("--bg", "--no-parent", "--no-notify", "--keep")],
        }
        if f:
            return fail(f["kind"], f.get("code", 1))
        out({"address": addr, "name": opt(opts, "--name"), "state": "live", "turn": 0})
        return 0
    if f:
        return fail(f["kind"], f.get("code", 1))
    if cmd == "get":
        t = find(st, args[0])
        if not t:
            return fail("not_found", 3)
        out({"title": "", **{k: v for k, v in t.items() if k != "flags"}})
        return 0
    if cmd == "ls":
        items = [ls_item(t) for t in st["terminals"].values() if "--all" in args or t["state"] == "live"]
        out({"hidden_finished": 0, "terminals": items})
        return 0
    if cmd == "read":
        t = find(st, args[0])
        if not t:
            return fail("not_found", 3)
        print(st.get("screens", {}).get(t["address"], ""))
        return 0
    if cmd == "send":
        t = find(st, args[0])
        if not t:
            return fail("not_found", 3)
        want = opt(args, "--if")
        # on_send(0.2.0): accept·drop 은 상태를 바꾸지 않는다(유실은 시험이 turn 을 그대로 두어 흉내 낸다),
        # working 은 일을 시작한 것으로, mismatch 는 그 사이 상태가 바뀐 것으로 거부한다
        mode = st.get("on_send", {}).get(t["address"], "accept")
        if mode == "mismatch" or (want and (t.get("status") or {}).get("state") != want):
            return fail("status_mismatch", 10)
        # tagged: 받은 환경에 HC_TERMINAL_ID 가 있었나(실제 hc 는 그때 <hc from=…> 로 감싼다, herdr-orch 설계 13.1)
        st.setdefault("sent", []).append({"terminal": t["address"], "text": args[1], "if": want,
                                          "tagged": bool(os.environ.get("HC_TERMINAL_ID"))})
        if mode == "working":
            t["status"] = {"app": "claude-code", "msg": "", **(t.get("status") or {}), "state": "working"}
        out({"sent": True, "started": True, "status": (t.get("status") or {}).get("state"), "turn": t.get("turn", 0)})
        return 0
    if cmd == "label":
        t = find(st, args[0])
        if not t:
            return fail("not_found", 3)
        for pair in args[1:]:
            if pair == "--json":
                continue
            key, _, value = pair.partition("=")
            if value:
                t["labels"][key] = value
            else:
                t["labels"].pop(key, None)
        out({"address": t["address"], "labels": t["labels"]})
        return 0
    if cmd == "kill":
        t = find(st, args[0])
        if not t:
            return fail("not_found", 3)
        if t["state"] == "finished":
            return fail("finished", 11)
        t["state"], t["exit_code"] = "finished", 143
        out({"killed": True})
        return 0
    if cmd == "rm":
        t = find(st, args[0])
        if not t:
            return fail("not_found", 3)
        if t["state"] != "finished":
            return fail("live", 10)
        del st["terminals"][t["address"]]
        out({"removed": True})
        return 0
    if cmd == "keys":
        rest = [a for a in args if a != "--json"]
        t = find(st, rest[0]) if rest else None
        if not t:
            return fail("not_found", 3)
        keys = rest[1:]
        rec = {"terminal": t["address"], "keys": keys}
        st.setdefault("keys", []).append(rec)
        # `/clear [space <이름>] enter`: on_clear 가 turn 이면 비운 것으로(turn+1, idle). 이름이 있으면 Codex 처럼 제목을 정한다
        if keys[:6] == ["/", "c", "l", "e", "a", "r"] and keys[-1:] == ["enter"]:
            mode = st.get("on_clear", {}).get(t["address"], "turn")
            title = (f"{''.join(keys[7:-1])} | {os.path.basename(t.get('cwd') or '/')}" if keys[6:7] == ["space"]
                     else None)
            if mode == "turn":
                t["turn"] = t.get("turn", 0) + 1
                t["status"] = {"app": "claude-code", "msg": "", **(t.get("status") or {}), "state": "idle"}
                if title:
                    t["title"] = title
            elif mode == "event":  # turn 사건만 준다(hc get 은 옛 turn). 지금 붙어 있는 구독에만, 0.3초 늦게
                subs = live_subscribers(st, t["address"])
                rec["subscribed"] = bool(subs)
                if subs:
                    lines = [notice("turn", t["address"], 0, {"state": "idle", "turn": t.get("turn", 0) + 1})]
                    if title:
                        lines.append(notice("title", t["address"], 0, {"title": title}))
                    for line in lines:
                        st.setdefault("pending_events", {}).setdefault(t["address"], []).append(
                            {"to": list(subs), "at": time.time() + 0.3, "line": line})
        out({"status": None, "turn": 0})  # 실제 hc keys --json 의 결과 꼴
        return 0
    if cmd == "connect":
        # JSON-RPC 한 줄에 한 응답. doc.get {"name": "herdr-app"} 만 안다(herdr-team 의 배치 확인이 쓴다)
        for line in lines:
            if not line.strip():
                continue
            req = json.loads(line)
            if req.get("method") == "doc.get" and (req.get("params") or {}).get("name") == "herdr-app":
                print(json.dumps({"jsonrpc": "2.0", "id": req.get("id"),
                                  "result": {"value": st.get("doc") or doc_of(st), "version": 1}}))
            else:
                print(json.dumps({"jsonrpc": "2.0", "id": req.get("id"),
                                  "error": {"code": -32601, "message": "method not found"}}))
        return 0
    if cmd == "server":
        out({"pid": 1, "live": len(st["terminals"]), "version": "0.1.18"})
        return 0
    return fail("usage", 2)


def main(argv):
    with open(DIR / "calls.jsonl", "a") as f:
        f.write(json.dumps(argv) + "\n")
    with open(DIR / "lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        delays = json.loads((DIR / "state.json").read_text()).get("delay", {})
        delay = float(delays.get(" ".join(argv[:2]), delays.get(argv[0] if argv else "", 0)))
    if delay:
        time.sleep(delay)  # 느린 hc 흉내. 잠금 밖에서 자서 다른 hc 호출을 막지 않는다
    if argv[:1] == ["events"]:
        return events(argv[1:])
    if argv[:1] == ["keys"]:
        wait_subscriber(argv[1:])
    lines = sys.stdin.read().splitlines() if argv[:1] == ["connect"] else ()  # 잠금 밖에서 요청을 다 읽는다
    with open(DIR / "lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = DIR / "state.json"
        st = json.loads(path.read_text())
        code = handle(st, argv, lines)
        path.write_text(json.dumps(st))
    return code


def live_subscribers(st, address):
    """그 터미널의 events 구독 가운데 살아 있는 프로세스(pid)."""
    alive = []
    for pid in st.get("subscribers", {}).get(address, []):
        try:
            os.kill(pid, 0)
        except OSError:
            continue
        alive.append(pid)
    return alive


def wait_subscriber(args):
    """on_clear 가 event 인 터미널이면 keys 를 처리하기 전에(잠금 밖에서) 그 터미널의 구독이 붙기를 3초까지 기다린다.
    keys 보다 먼저 띄운 구독은 늦게 떠도 여기서 붙는다. keys 뒤에 띄우는 구독은 붙지 않아 subscribed=false 다."""
    rest = [a for a in args if a != "--json"]
    end = time.monotonic() + 3
    while rest:
        with open(DIR / "lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            st = json.loads((DIR / "state.json").read_text())
        t = find(st, rest[0])
        if (t is None or st.get("on_clear", {}).get(t["address"]) != "event" or live_subscribers(st, t["address"])
                or time.monotonic() >= end):
            return
        time.sleep(0.05)


def events(args):
    """hc events --json --terminal T 흉내(실제 꼴): 처음 스냅숏 한 줄, 그 뒤 상태·turn·제목이 바뀔 때마다 그 종류의 알림 한 줄
    (status → turn → title 차례). 잠금은 볼 때만 잡는다. 처음 볼 때 "subscribers" 에 자기 pid 를 올리고, on_clear: event 가
    이 구독에 남긴 알림(pending_events)은 때가 되면 낸다."""
    term = opt(args, "--terminal")
    end = time.monotonic() + float(os.environ.get("FAKE_HC_EVENTS_MAX", "30"))
    last = None
    seq = 0
    me = os.getpid()
    joined = False
    while True:
        due = []
        with open(DIR / "lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            path = DIR / "state.json"
            st = json.loads(path.read_text())
            f = st.get("fail", {}).get("events")
            if f:
                return fail(f["kind"], f.get("code", 1))
            t = find(st, term) if term else None
            if t is None:
                return fail("not_found", 3) if last is None else 0
            changed = False
            if not joined:
                st.setdefault("subscribers", {}).setdefault(t["address"], []).append(me)
                joined = changed = True
            for ev in st.get("pending_events", {}).get(t["address"], []):
                if me in ev["to"] and ev["at"] <= time.time():
                    ev["to"].remove(me)
                    due.append(ev["line"])
                    changed = True
            if changed:
                path.write_text(json.dumps(st))
        addr = t["address"]
        cur = {"status": t.get("status"), "turn": t.get("turn", 0), "title": t.get("title", "")}
        out_lines = []
        if last is None:
            seq += 1
            out_lines.append({"channel": None, "seq": seq,
                              "terminals": [{"title": "", **{k: v for k, v in t.items() if k != "flags"}}]})
            noise = float(st.get("noise", {}).get(addr, 0))
        else:
            if cur["status"] != last["status"]:
                seq += 1
                out_lines.append(notice("status", addr, seq, {"records": {}, "reported": cur["status"] is not None,
                                                              "status": cur["status"]}))
            if cur["turn"] != last["turn"]:
                seq += 1
                out_lines.append(notice("turn", addr, seq, {"state": (cur["status"] or {}).get("state"),
                                                            "turn": cur["turn"]}))
            if cur["title"] != last["title"]:
                seq += 1
                out_lines.append(notice("title", addr, seq, {"title": cur["title"]}))
        for line in due:
            seq += 1
            line["params"]["seq"] = seq
            out_lines.append(line)
        for line in out_lines:
            print(json.dumps(line), flush=True)
        if last is None and noise:
            # 잠금 밖에서 큰 묶음으로 쉬지 않고 쓴다. 파이프가 늘 차 있어 읽는 쪽에는 언제나 읽을 것이 있다
            blob = "".join(json.dumps(notice("heartbeat", addr, 0, {})) + "\n" for _ in range(2000))
            until = time.monotonic() + noise
            while time.monotonic() < until:
                sys.stdout.write(blob)
                sys.stdout.flush()
        last = cur
        if time.monotonic() >= end:
            return 0
        time.sleep(0.05)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
